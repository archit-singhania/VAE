AEVRA_ENV=development
AEVRA_WEB_PORT=3001
AEVRA_SECRET_KEY=replace-with-at-least-32-random-characters
AEVRA_TOKEN_VAULT_KEY=replace-with-a-different-at-least-32-random-key
AEVRA_ACCESS_TOKEN_MINUTES=30
AEVRA_ALLOWED_ORIGINS=http://localhost:3000
AEVRA_ENABLE_REDIS_RATE_LIMIT=1
AEVRA_REDIS_RATE_LIMIT_PREFIX=aevra:rate-limit
AEVRA_API_RATE_LIMIT_ATTEMPTS=120
AEVRA_API_RATE_LIMIT_WINDOW_SECONDS=60
AEVRA_SEED_EMAIL=owner@aevra.local
AEVRA_SEED_PASSWORD=AevraLocalOnly!2026
AEVRA_ADMIN_EMAIL=admin@vae.local
AEVRA_ADMIN_PASSWORD=VaeAdminLocalOnly!2026
AEVRA_ADMIN_DISPLAY_NAME=VAE Admin
AEVRA_MANUAL_PAYMENT_APPROVAL_ENABLED=1
AEVRA_PAYMENT_AMOUNT=0
AEVRA_PAYMENT_CURRENCY=INR
AEVRA_PAYMENT_UPI_ID=
AEVRA_PAYMENT_QR_URL=
AEVRA_PAYMENT_SUPPORT_EMAIL=support@vae.local
AEVRA_PAYMENT_EXPIRY_DAYS=7
AEVRA_DATABASE_URL=postgresql+psycopg://aevra:aevra@postgres:5432/aevra
REDIS_URL=redis://redis:6379/0
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=aevra
MINIO_SECRET_KEY=replace-me
MINIO_BUCKET=aevra-assets
AEVRA_EMBEDDING_PROVIDER=ollama
AEVRA_EMBEDDING_MODEL=nomic-embed-text
AEVRA_EMBEDDING_DIMENSIONS=384
AEVRA_OLLAMA_BASE_URL=http://host.docker.internal:11434
AEVRA_OLLAMA_MODEL=qwen3:8b
AEVRA_OLLAMA_TIMEOUT_SECONDS=120
AEVRA_KNOWLEDGE_CHUNK_CHARS=900
AEVRA_KNOWLEDGE_CHUNK_OVERLAP=120
AEVRA_MAX_DOCUMENT_BYTES=20971520
AEVRA_MEDIA_ROOT=./media
AEVRA_IMAGE_PROVIDER=deterministic
AEVRA_FLUX_BASE_URL=http://localhost:8188
AEVRA_FLUX_TIMEOUT_SECONDS=120
AEVRA_VIDEO_PROVIDER=ffmpeg
AEVRA_FFMPEG_BINARY=ffmpeg
AEVRA_FFPROBE_BINARY=ffprobe
AEVRA_VIDEO_DEFAULT_SECONDS=6
AEVRA_VIDEO_MAX_SECONDS=60
AEVRA_VIDEO_FPS=30
AEVRA_REDIS_URL=redis://redis:6379/0
AEVRA_ENABLE_CELERY=0
AEVRA_STORAGE_BACKEND=local
AEVRA_MINIO_ENDPOINT=minio:9000
AEVRA_MINIO_ACCESS_KEY=aevra
AEVRA_MINIO_SECRET_KEY=replace-me
AEVRA_MINIO_BUCKET=aevra-assets
AEVRA_MINIO_SECURE=0
AEVRA_OAUTH_STATE_MINUTES=10
# API callback origin (Render in staging/production). Keep provider secrets out of Git.
AEVRA_OAUTH_REDIRECT_BASE_URL=http://localhost:8000
# Browser origin used after a successful provider callback.
AEVRA_OAUTH_FRONTEND_URL=http://localhost:3000
AEVRA_META_OAUTH_CLIENT_ID=
AEVRA_META_OAUTH_CLIENT_SECRET=
# Optional separate Instagram Business Login credentials. Leave blank to use
# the Meta application credentials for the shared Meta login flow.
AEVRA_INSTAGRAM_OAUTH_CLIENT_ID=
AEVRA_INSTAGRAM_OAUTH_CLIENT_SECRET=
AEVRA_THREADS_OAUTH_CLIENT_ID=
AEVRA_THREADS_OAUTH_CLIENT_SECRET=
AEVRA_LINKEDIN_OAUTH_CLIENT_ID=
AEVRA_LINKEDIN_OAUTH_CLIENT_SECRET=
AEVRA_YOUTUBE_OAUTH_CLIENT_ID=
AEVRA_YOUTUBE_OAUTH_CLIENT_SECRET=
# Browser requests use the same-origin Next.js proxy. The server-side rewrite
# forwards them to AEVRA_API_ORIGIN (Render in production).
NEXT_PUBLIC_API_URL=/api/v1
AEVRA_API_ORIGIN=http://localhost:8000
